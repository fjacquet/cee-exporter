# Binaries
/cee-exporter
/cee-exporter-darwin
/cee-exporter.exe

# CA bundle staged into the build context by the goreleaser before: hook
/ca-certificates.crt

# Go test & coverage artifacts
*.test
coverage.out
*.coverprofile

# MkDocs generated site
/site/

# goreleaser output. `make sbom` and any local `goreleaser build` fill this
# with the full release matrix — five binaries, ~60 MB — and `make clean`
# removes it. It was never ignored, so a `git add -A` would happily commit
# the lot; that is exactly what happened once while writing this commit.
/dist/

# windmc C header — only useful to C code, which this repo has none of. The
# .syso (committed) is what the Go linker consumes; `make winres` regenerates
# this deterministically from pkg/evtx/messages.mc any time it's needed.
/pkg/evtx/messages.h

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo
# Added by code-review-graph
.code-review-graph/

# Python bytecode / venv for tools/evtx-debug
__pycache__/
*.pyc
.venv/

# Local compose secrets — never commit a real password
deploy/.env
.env
