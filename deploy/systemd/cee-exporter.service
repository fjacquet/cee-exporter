[Unit]
Description=Dell PowerStore CEPA to Windows Event Log bridge
Documentation=https://github.com/fjacquet/cee-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# DynamicUser provisions a transient unprivileged UID/GID for each start, so no
# useradd step is needed. Combined with LogsDirectory and StateDirectory below,
# systemd creates and chowns every path the daemon writes to.
DynamicUser=yes
WorkingDirectory=/etc/cee-exporter
ExecStart=/usr/local/bin/cee-exporter -config /etc/cee-exporter/config.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
Environment=CEE_LOG_FORMAT=json
EnvironmentFile=-/etc/cee-exporter/env

# File descriptor limit for high-throughput CEPA ingestion
LimitNOFILE=65536

# Filesystem hardening — daemon only needs write access to its log dir
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
# AmbientCapabilities grants CAP_NET_BIND_SERVICE so that the daemon can bind
# to privileged ports (e.g. :443 for ACME TLS-ALPN-01 challenge listener) when
# tls_mode="acme" is configured. Has no effect when tls_mode is off/manual/self-signed.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
# LogsDirectory creates and chowns /var/log/cee-exporter/ on each start.
# Set evtx_path = "/var/log/cee-exporter/audit.evtx" in config.toml.
LogsDirectory=cee-exporter
LogsDirectoryMode=0750

# StateDirectory creates and chowns /var/lib/cee-exporter/ on each start.
StateDirectory=cee-exporter
StateDirectoryMode=0750

# CacheDirectory creates and chowns /var/cache/cee-exporter/ on each start —
# this is what makes the config default (acme_cache_dir =
# "/var/cache/cee-exporter/acme") writable under this unit with no operator
# action. autocert.DirCache creates the "acme" subdirectory itself on first
# write, once its parent is writable.
CacheDirectory=cee-exporter
CacheDirectoryMode=0750

[Install]
WantedBy=multi-user.target
