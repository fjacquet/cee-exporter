          "datasource": {
            "type": "prometheus",
            "uid": "cee-prometheus"
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "lastNotNull",
                "max"
              ]
