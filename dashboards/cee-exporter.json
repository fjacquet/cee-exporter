    {
      "id": 3,
      "type": "timeseries",
      "title": "Event throughput",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "rate(cee_events_received_total[5m])",
          "legendFormat": "{{instance}} received",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cee-prometheus"
          }
        },
        {
          "expr": "rate(cee_events_written_total[5m])",
          "legendFormat": "{{instance}} written",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cee-prometheus"
          }
        },
        {
          "expr": "rate(cee_events_dropped_total[5m])",
          "legendFormat": "{{instance}} dropped",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "cee-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "eps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*written$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*dropped$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    2,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cee-prometheus"
      },
      "description": "Events per second, per exporter instance. received is what was parsed off the wire, written is what reached the output, dropped is what was lost — so received is the parse rate and received minus written is backlog.\n\nThe three series overlap exactly on a healthy pipeline: received and written carry identical values and one hides the other, which reads as a single line or as no line at all when it sits against the top of the axis. written and dropped are dashed so received stays visible beneath them, and the legend carries the numbers so the panel is readable even when the traces coincide.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
