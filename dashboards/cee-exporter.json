    {
      "id": 9,
      "type": "stat",
      "title": "Dropped + truncated",
      "description": "Dropped plus truncated, cumulative. The only tile here that carries colour, because the reading is a state and not a quantity: zero is green, anything else is red and means audit records were lost or cut. Colour is reserved for exactly this.",
      "gridPos": {
