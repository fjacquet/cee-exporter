# cee-exporter configuration example
# Copy to config.toml and adjust for your environment.
#
# Environment variable overrides:
#   CEE_LOG_LEVEL   — debug | info | warn | error
#   CEE_LOG_FORMAT  — json | text

# Hostname embedded in every generated event.
# Defaults to os.Hostname() if not set.
# Tip: set this to the PowerStore NAS hostname for easier correlation.
# hostname = "powerstore-nas01"

# ─────────────────────────────────────────────────────────────────────────────
# HTTP listener
# ─────────────────────────────────────────────────────────────────────────────
[listen]
addr = "0.0.0.0:12228"

# TLS mode — controls how the CEPA listener obtains its TLS certificate.
#
# IMPORTANT: Dell PowerStore CEPA sends events over plain HTTP only. TLS on
# port 12228 does NOT encrypt the PowerStore→exporter path. Use TLS here only
# if a TLS-capable reverse proxy sits between PowerStore and cee-exporter.
#
#   off         — No TLS (default). Plain HTTP on addr.
#   manual      — Load cert and key from cert_file / key_file.
#   acme        — Obtain and auto-renew certificate from Let's Encrypt via
#                 ACME TLS-ALPN-01. Requires port 443 reachable from the
#                 internet and acme_domains set. Needs CAP_NET_BIND_SERVICE
#                 on Linux (systemd unit adds it when this mode is used).
#   self-signed — Generate a runtime self-signed ECDSA cert. No files, no
#                 network. Useful for air-gapped or private-network deployments
#                 where TLS termination is desired but public CA is unavailable.
#
# Backward compat: the old tls=true + cert_file/key_file combination is
# automatically treated as tls_mode="manual".
#
tls_mode = "off"

# tls_mode = "manual" — provide paths to your certificate and private key:
# cert_file = "/etc/cee-exporter/tls/server.crt"
# key_file  = "/etc/cee-exporter/tls/server.key"

# tls_mode = "acme" — Let's Encrypt automatic certificate:
# acme_domains        = ["cepa.example.com"]
# acme_email          = "ops@example.com"
# acme_cache_dir      = "/var/cache/cee-exporter/acme"
# acme_challenge_addr = ":443"   # port must be 443 for TLS-ALPN-01

# tls_mode = "self-signed" — runtime-generated cert (no files needed):
# (no additional fields required)

# ─────────────────────────────────────────────────────────────────────────────
# Output backend
#
# type = "gelf"   → GELF JSON over UDP/TCP to Graylog (recommended for Linux)
# type = "evtx"   → Binary .evtx file (Windows: Win32 API; Linux: BinaryEvtxWriter)
# type = "syslog" → RFC 5424 structured syslog over UDP or TCP
# type = "beats"  → Lumberjack v2 to Logstash / Graylog Beats Input (± TLS)
# type = "multi"  → Fan-out to multiple backends simultaneously
# ─────────────────────────────────────────────────────────────────────────────
[output]
type = "gelf"

# GELF output (Graylog)
gelf_host     = "graylog.corp.local"
gelf_port     = 12201
gelf_protocol = "udp"   # or "tcp"
gelf_tls      = false   # only applies when gelf_protocol = "tcp"

# EVTX output: path to the .evtx file (Linux BinaryEvtxWriter writes on Close)
# evtx_path = "/var/log/cee-exporter/audit.evtx"

# EVTX durability and rotation (applies only when type = "evtx")
#
# flush_interval_s — Interval in seconds between periodic checkpoint writes (fsync).
#   Bounds maximum data loss on power failure to this many seconds.
#   Must be > 0 when type = "evtx" (0 disables fsync and risks data loss on crash).
#   Default: 15
# flush_interval_s = 15
#
# max_file_size_mb — Rotate the active .evtx file when it reaches this size in MiB.
#   0 = unlimited (file grows without bound).
#   Default: 0
# max_file_size_mb = 0
#
# max_file_count — Keep only the N most recent archive .evtx files; delete older ones.
#   0 = unlimited (all archives are kept).
#   Default: 0
# max_file_count = 0
#
# rotation_interval_h — Rotate the active .evtx file every N hours regardless of size.
#   0 = disabled (no time-based rotation).
#   Send SIGHUP to trigger an immediate rotation at any time.
#   Default: 0
# rotation_interval_h = 0

# Syslog output (RFC 5424, uncomment to enable directly or via type = "multi")
#
# syslog_host     — Syslog receiver hostname/IP.
#   Default: "localhost"
# syslog_host = "syslog.corp.local"
#
# syslog_port — Syslog receiver port.
#   Default: 514
# syslog_port = 514
#
# syslog_protocol — "udp" or "tcp". TCP uses RFC 6587 octet-counting framing.
#   Default: "udp"
# syslog_protocol = "udp"
#
# syslog_app_name — APP-NAME field in the RFC 5424 header.
#   Default: "cee-exporter"
# syslog_app_name = "cee-exporter"

# Beats / Lumberjack v2 output (uncomment to enable directly or via type = "multi")
#
# beats_host — Logstash or Graylog Beats Input hostname/IP.
#   Default: "localhost"
# beats_host = "logstash.corp.local"
#
# beats_port — Beats Input port.
#   Default: 5044 (the Logstash/Graylog Beats Input standard port)
# beats_port = 5044
#
# beats_tls — Wrap the connection in TLS. The receiver must have a TLS-enabled
#   Beats Input configured.
#   Default: false
# beats_tls = false

# Multi-target example (fan-out to both GELF and EVTX)
# type    = "multi"
# targets = ["gelf", "evtx"]

# ─────────────────────────────────────────────────────────────────────────────
# Async queue
# ─────────────────────────────────────────────────────────────────────────────
[queue]
capacity = 100000  # max events buffered before dropping
workers  = 4       # concurrent writer goroutines

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
[logging]
level  = "info"  # debug | info | warn | error
format = "json"  # json (production) | text (development)

# ─────────────────────────────────────────────────────────────────────────────
# Prometheus /metrics endpoint
# Scrape with: curl http://HOST:9228/metrics
# Default port 9228 is separate from the CEPA listener port 12228.
# ─────────────────────────────────────────────────────────────────────────────
[metrics]
enabled = true
addr    = "0.0.0.0:9228"
