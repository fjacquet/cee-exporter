# cee-exporter configuration example
# Copy to config.toml and adjust for your environment.
#
# Environment variable overrides:
#   CEE_LOG_LEVEL   — debug | info | warn | error
#   CEE_LOG_FORMAT  — json | text

# Hostname embedded in every generated event.
# Defaults to os.Hostname() if not set.
# Tip: set this to the PowerStore NAS hostname for easier correlation.
# hostname = "powerstore-nas01"

# ─────────────────────────────────────────────────────────────────────────────
# HTTP listener — the port CEE sends events TO
#
# 12228 is NOT a CEPA default. It is CEE's OWN listener port: the *Common Event
# Enabler Security Configuration Guide 9.x* (p.8) gives 12228 as the default for
# Platform-to-CEE messaging, and says of the CEE-to-partner direction — which is
# this exporter — "the port which the system administrator selected". There is
# no assigned default; the admin picks it, on both ends, and it must match the
# port in CEE's EndPoint value.
#
# It is kept here because changing it would break every existing deployment for
# no gain, not because it is correct. Two consequences worth knowing:
#
#   - Co-resident with CEE, this WILL collide. CEE owns 12228 on its own host,
#     so an exporter there must use something else.
#   - A reference deployment runs the exporter on 12229 with CEE's EndPoint set
#     to http://<host>:12229, precisely because both once shared a host.
# ─────────────────────────────────────────────────────────────────────────────
[listen]
addr = "0.0.0.0:12228"

# TLS mode — controls how the CEPA listener obtains its TLS certificate.
#
# IMPORTANT: Dell PowerStore CEPA sends events over plain HTTP only. TLS on
# the listener port does NOT encrypt the PowerStore→exporter path. Use TLS here only
# if a TLS-capable reverse proxy sits between PowerStore and cee-exporter.
#
#   off         — No TLS (default). Plain HTTP on addr.
#   manual      — Load cert and key from cert_file / key_file.
#   acme        — Obtain and auto-renew certificate from Let's Encrypt via
#                 ACME TLS-ALPN-01. Requires port 443 reachable from the
#                 internet and acme_domains set. Needs CAP_NET_BIND_SERVICE
#                 on Linux (systemd unit adds it when this mode is used).
#   self-signed — Generate a runtime self-signed ECDSA cert. No files, no
#                 network. Useful for air-gapped or private-network deployments
#                 where TLS termination is desired but public CA is unavailable.
#
# Backward compat: the old tls=true + cert_file/key_file combination is
# automatically treated as tls_mode="manual".
#
tls_mode = "off"

# tls_mode = "manual" — provide paths to your certificate and private key:
# cert_file = "/etc/cee-exporter/tls/server.crt"
# key_file  = "/etc/cee-exporter/tls/server.key"

# tls_mode = "acme" — Let's Encrypt automatic certificate:
# acme_domains        = ["cepa.example.com"]
# acme_email          = "ops@example.com"
# acme_cache_dir      = "/var/cache/cee-exporter/acme"
# acme_challenge_addr = ":443"   # port must be 443 for TLS-ALPN-01

# tls_mode = "self-signed" — runtime-generated cert (no files needed):
# (no additional fields required)

# ─────────────────────────────────────────────────────────────────────────────
# Output backend
#
# type = "gelf"   → GELF JSON over UDP/TCP to Graylog (recommended for Linux)
# type = "evtx"   → Binary .evtx file (Windows: Win32 API; Linux: BinaryEvtxWriter)
# type = "syslog" → RFC 5424 structured syslog over UDP or TCP
# type = "beats"  → Lumberjack v2 to Logstash / Graylog Beats Input (± TLS)
# type = "multi"  → Fan-out to multiple backends simultaneously
# ─────────────────────────────────────────────────────────────────────────────
[output]
type = "gelf"

# GELF output (Graylog)
gelf_host     = "graylog.corp.local"
gelf_port     = 12201
gelf_protocol = "udp"   # or "tcp"
gelf_tls      = false   # only applies when gelf_protocol = "tcp"

# EVTX output: path to the .evtx file (Linux BinaryEvtxWriter writes on Close)
# evtx_path = "/var/log/cee-exporter/audit.evtx"

# EVTX durability and rotation (applies only when type = "evtx")
#
# flush_interval_s — Interval in seconds between periodic checkpoint writes (fsync).
#   Bounds maximum data loss on power failure to this many seconds.
#   Must be > 0 when type = "evtx" (0 disables fsync and risks data loss on crash).
#   Default: 15
# flush_interval_s = 15
#
# max_file_size_mb — Rotate the active .evtx file when it reaches this size in MiB.
#   0 = unlimited (file grows without bound).
#   Default: 0
# max_file_size_mb = 0
#
# max_file_count — Keep only the N most recent archive .evtx files; delete older ones.
#   0 = unlimited (all archives are kept).
#   Default: 0
# max_file_count = 0
#
# rotation_interval_h — Rotate the active .evtx file every N hours regardless of size.
#   0 = disabled (no time-based rotation).
#   Send SIGHUP to trigger an immediate rotation at any time.
#   Default: 0
# rotation_interval_h = 0

# Syslog output (RFC 5424, uncomment to enable directly or via type = "multi")
#
# syslog_host     — Syslog receiver hostname/IP.
#   Default: "localhost"
# syslog_host = "syslog.corp.local"
#
# syslog_port — Syslog receiver port.
#   Default: 514
# syslog_port = 514
#
# syslog_protocol — "udp" or "tcp". TCP uses RFC 6587 octet-counting framing.
#   Default: "udp"
# syslog_protocol = "udp"
#
# syslog_app_name — APP-NAME field in the RFC 5424 header.
#   Default: "cee-exporter"
# syslog_app_name = "cee-exporter"

# Beats / Lumberjack v2 output (uncomment to enable directly or via type = "multi")
#
# beats_host — Logstash or Graylog Beats Input hostname/IP.
#   Default: "localhost"
# beats_host = "logstash.corp.local"
#
# beats_port — Beats Input port.
#   Default: 5044 (the Logstash/Graylog Beats Input standard port)
# beats_port = 5044
#
# beats_tls — Wrap the connection in TLS. The receiver must have a TLS-enabled
#   Beats Input configured.
#   Default: false
# beats_tls = false

# Multi-target example (fan-out to both GELF and EVTX)
# type    = "multi"
# targets = ["gelf", "evtx"]

# ─────────────────────────────────────────────────────────────────────────────
# Async queue
# ─────────────────────────────────────────────────────────────────────────────
[queue]
capacity = 100000  # max events buffered before dropping
workers  = 4       # concurrent writer goroutines

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
[logging]
level  = "info"  # debug | info | warn | error
format = "json"  # json (production) | text (development)

# ─────────────────────────────────────────────────────────────────────────────
# Prometheus /metrics endpoint
# Scrape with: curl http://HOST:9228/metrics
# Default port 9228 is separate from the port CEE sends events to (see
# [listen] above — 12228 there is CEE's own default, borrowed, not assigned).
# ─────────────────────────────────────────────────────────────────────────────
[metrics]
enabled = true
addr    = "0.0.0.0:9228"

# ─────────────────────────────────────────────────────────────────────────────
# CEPA registration
#
# Dell CEE will not send events to a consumer it has not registered. It PUTs
# <RegisterRequest /> here every 10 s and parses the reply; until that
# succeeds it answers every array heartbeat status="0x16"
# (VC_ERROR_CEPP_NOT_FOUND) and the array never publishes at all.
#
# friendly_name and guid must be set TOGETHER, to a matching pair from CEE's
# compiled-in allowlist. CEE keys CGuidStore on (friendlyName, facility) -> GUID
# and refuses anything else with "unknown or invalid GUID": it registers no
# partner, answers the array 0x16 CEPP_NOT_FOUND, and every observable on this
# side stays green. A self-generated GUID never works, and neither does a known
# partner name paired with the wrong GUID -- so changing friendly_name alone
# leaves you with no registration and no events.
#
# The defaults below are NOT allowlisted; they are placeholders. Take a real row
# from cee-worker's docs/cee-partner-allowlist.md (47 entries, e.g.
# SimpleCEPPServer, SampleCEPPServer, PeerSoftwareCollector, SplunkHEC) and set
# both fields from that same row. See docs/adr/ADR-017-cee-partner-identity.md.
# ─────────────────────────────────────────────────────────────────────────────
[cepa]
# friendly_name = "ceeexporter"
# guid          = "bbefd339-b011-4c7a-89a7-1180d5d531c2"
# description   = "cee-exporter CEPA consumer"

# Protocol codes CEE filters on: 0=CIFS, 1=NFS, 2=FTP, 3=Unknown.
# protocols = "0,1"

# EventTypeFilter: three 32-bit words, one per event phase (pre, post-success,
# post-failure). The default sets every bit of the FIRST word and leaves the
# other two zero, matching both known-good captures — CEE's own SplunkHEC
# template and Varonis. The all-96-bits value this file used to show sets bits
# in words no observed consumer ever sets. Narrow it only against observed
# traffic — a wrong guess here subscribes to nothing and looks like success.
# event_filter = "0xFFFFFFFF0000000000000000"

# ─────────────────────────────────────────────────────────────────────────────
# Request limits
#
# Bounds what one CEPA request may cost. A single 64 MiB body (the old,
# unconditional cap) measured 269 MiB of live heap and 495 MiB of RSS, with
# nothing capping how many could be in flight at once — a handful of
# concurrent full-size PUTs was an OOM. A realistic 1000-event VCAPS batch is
# ~350 KB, so these defaults have ample headroom.
#
# On saturation, requests WAIT for a free slot rather than being rejected —
# the body is read before the CEPA ACK, so rejecting would lose the publisher
# entirely. A too-low max_concurrent_requests therefore shows up as missed
# 3-second ACKs and publishers going OFFLINE, not as errors in this
# consumer's log. Watch cee_requests_throttled_total.
# ─────────────────────────────────────────────────────────────────────────────
[server]
max_body_mb             = 8  # per-request body cap; ~23k events
max_concurrent_requests = 8  # bodies in flight at once; worst-case live heap ~270 MiB
